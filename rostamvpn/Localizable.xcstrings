    "%@ provides fast, secure, and private internet access using multiple advanced encryption protocols and a global network of high-performance servers.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ በርካታ ዘመናዊ የምስጠራ ፕሮቶኮሎችንና ዓለም አቀፍ ከፍተኛ አፈጻጸም ያላቸው አገልጋዮች መረብን በመጠቀም ፈጣን፣ ደኅንነቱ የተጠበቀና ግላዊ የኢንተርኔት አገልግሎት ይሰጣል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفّر %@ وصولاً سريعاً وآمناً وخاصاً إلى الإنترنت باستخدام عدة بروتوكولات تشفير متقدمة وشبكة عالمية من الخوادم عالية الأداء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir neçə qabaqcıl şifrələmə protokolu və yüksək məhsuldarlıqlı serverlərdən ibarət qlobal şəbəkə vasitəsilə sürətli, təhlükəsiz və məxfi internet girişi təmin edir."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بیر نئچه قاباقجیل شیفره‌له‌مه پروتوکولو و یوکسک گوجلو سرورلردن عبارت گلوبال بیر شبکه ایله سورعتلی، تحلوکه‌سیز و محرم اینترنت گیریشی تأمین ائدیر."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забяспечвае хуткі, бяспечны і прыватны доступ да інтэрнэту з дапамогай некалькіх сучасных пратаколаў шыфравання і глабальнай сеткі высокапрадукцыйных сервераў."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ཡིས་གསང་སྡོམ་བྱ་སྤྱོད་ལམ་ལུགས་མཐོ་རིམ་མང་པོ་དང་ནུས་པ་ཆེ་བའི་ཞབས་ཞུ་ཡོ་བྱད་ཀྱི་འཛམ་གླིང་དྲ་རྒྱ་བརྒྱུད་ནས་མགྱོགས་ཤིང་བདེ་འཇགས་ལྡན་པའི་གསང་དོན་ཅན་གྱི་དྲ་རྒྱའི་ཞབས་ཞུ་སྤྲོད་ཀྱི་ཡོད།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بە بەکارهێنانی چەند پرۆتۆکۆڵێکی شیفرەکردنی پێشکەوتوو و تۆڕێکی جیهانی لە ڕاژەکارە بەتوانەکان، دەستڕاگەیشتنێکی خێرا، پارێزراو و تایبەت بە ئینتەرنێت دەڕەخسێنێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bietet schnellen, sicheren und privaten Internetzugang über mehrere fortschrittliche Verschlüsselungsprotokolle und ein weltweites Netz leistungsstarker Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ προσφέρει γρήγορη, ασφαλή και ιδιωτική πρόσβαση στο διαδίκτυο, με πολλαπλά προηγμένα πρωτόκολλα κρυπτογράφησης και ένα παγκόσμιο δίκτυο διακομιστών υψηλών επιδόσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ provides fast, secure, and private internet access using multiple advanced encryption protocols and a global network of high-performance servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ofrece un acceso a internet rápido, seguro y privado mediante varios protocolos de cifrado avanzados y una red global de servidores de alto rendimiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ با استفاده از چند پروتکل رمزگذاری پیشرفته و شبکه‌ای جهانی از سرورهای پرسرعت، دسترسی سریع، امن و خصوصی به اینترنت فراهم می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarjoaa nopean, turvallisen ja yksityisen internetyhteyden useiden kehittyneiden salausprotokollien ja maailmanlaajuisen tehokkaiden palvelimien verkon avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ offre un accès à Internet rapide, sécurisé et privé grâce à plusieurs protocoles de chiffrement avancés et à un réseau mondial de serveurs haute performance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מספק גישה מהירה, מאובטחת ופרטית לאינטרנט באמצעות מספר פרוטוקולי הצפנה מתקדמים ורשת עולמית של שרתים בעלי ביצועים גבוהים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कई उन्नत एन्क्रिप्शन प्रोटोकॉल और उच्च-प्रदर्शन सर्वरों के वैश्विक नेटवर्क के ज़रिए तेज़, सुरक्षित और निजी इंटरनेट पहुँच देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ omogućuje brz, siguran i privatan pristup internetu pomoću više naprednih protokola šifriranja i globalne mreže poslužitelja visokih performansi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ memberikan akses internet yang cepat, aman, dan privat menggunakan beberapa protokol enkripsi canggih serta jaringan server berkinerja tinggi di seluruh dunia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ offre un accesso a internet veloce, sicuro e privato grazie a diversi protocolli di crittografia avanzati e a una rete globale di server ad alte prestazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бірнеше озық шифрлау протоколы мен жоғары өнімді серверлердің жаһандық желісі арқылы жылдам, қауіпсіз әрі құпия интернет қолжетімділігін береді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ផ្តល់ការតភ្ជាប់អ៊ីនធឺណិតលឿន សុវត្ថិភាព និងឯកជន ដោយប្រើពិធីការអ៊ិនគ្រីបទំនើបជាច្រើន និងបណ្តាញម៉ាស៊ីនមេប្រតិបត្តិការខ្ពស់ទូទាំងពិភពលោក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 여러 고급 암호화 프로토콜과 전 세계 고성능 서버 네트워크를 사용해 빠르고 안전하며 사적인 인터넷 접속을 제공합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бир нече өнүккөн шифрлөө протоколу жана дүйнө жүзүндөгү жогорку майнаптуу серверлер тармагы аркылуу тез, коопсуз жана купуя интернет мүмкүнчүлүгүн берет."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ သည် အဆင့်မြင့် ကုဒ်ဝှက်စနစ်များစွာနှင့် ကမ္ဘာအနှံ့ရှိ စွမ်းဆောင်ရည်မြင့် ဆာဗာကွန်ရက်ကို အသုံးပြု၍ မြန်ဆန်ပြီး လုံခြုံကာ ကိုယ်ရေးလွတ်လပ်သော အင်တာနက်ကို ပေးပါသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gir rask, sikker og privat internettilgang med flere avanserte krypteringsprotokoller og et globalt nettverk av kraftige servere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ biedt snelle, veilige en private internettoegang via meerdere geavanceerde versleutelingsprotocollen en een wereldwijd netwerk van krachtige servers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oferece acesso à internet rápido, seguro e privado usando vários protocolos de criptografia avançados e uma rede global de servidores de alto desempenho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ обеспечивает быстрый, безопасный и приватный доступ в интернет с помощью нескольких современных протоколов шифрования и глобальной сети высокопроизводительных серверов."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hutoa muunganisho wa intaneti wa haraka, salama na wa faragha kwa kutumia itifaki kadhaa za kisasa za usimbaji fiche na mtandao wa kimataifa wa seva zenye utendaji wa juu."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бо истифода аз якчанд протоколи пешрафтаи рамзгузорӣ ва шабакаи ҷаҳонии серверҳои пурқувват дастрасии тез, бехатар ва махфиро ба интернет таъмин мекунад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ให้การเข้าถึงอินเทอร์เน็ตที่รวดเร็ว ปลอดภัย และเป็นส่วนตัว ด้วยโปรโตคอลการเข้ารหัสขั้นสูงหลายรูปแบบและเครือข่ายเซิร์ฟเวอร์ประสิทธิภาพสูงทั่วโลก"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ብዙሓት ዘመናውያን ናይ ምስጢራዊ ኮድ ፕሮቶኮላትን ዓለምለኻዊ መርበብ ልዑል ኣፈጻጽማ ዘለዎም ኣገልገልትን ብምጥቃም ቅልጡፍ፣ ውሑስን ውልቃውን መእተዊ ኢንተርነት የቕርብ።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ birnäçe ösen şifrleme protokoly we ýokary öndürijilikli serwerleriň dünýä tory arkaly çalt, howpsuz we gizlin internet elýeterliligini berýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, birden fazla gelişmiş şifreleme protokolü ve yüksek performanslı sunuculardan oluşan küresel bir ağ kullanarak hızlı, güvenli ve gizli internet erişimi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забезпечує швидкий, безпечний і приватний доступ до інтернету завдяки кільком сучасним протоколам шифрування та глобальній мережі високопродуктивних серверів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir nechta ilgʻor shifrlash protokoli va yuqori unumli serverlarning global tarmogʻi orqali tez, xavfsiz va maxfiy internetdan foydalanish imkonini beradi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mang lại truy cập internet nhanh, an toàn và riêng tư nhờ nhiều giao thức mã hóa tiên tiến và mạng lưới máy chủ hiệu năng cao trên toàn cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 通过多种先进加密协议和覆盖全球的高性能服务器网络，提供快速、安全、私密的互联网访问。"
          }
        }
      }
    },
