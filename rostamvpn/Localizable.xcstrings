    "No cap, and never slowed down.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ገደብ የለም፣ ፍጥነትም አይቀንስም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حد للاستهلاك، وبلا إبطاء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit yoxdur, sürət heç vaxt azaldılmır."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "لیمیت یوخدور، سوره‌ت هئچ واخت آزالدیلمیر."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ліміту і без запаволення."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཚད་བཀག་མེད་ལ། མྱུར་ཚད་ཀྱང་ནམ་ཡང་ཆག་མི་སྲིད།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سنووری بەکارهێنان نییە، خێراییش کەم ناکرێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Limit, und nie gedrosselt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς όριο και χωρίς επιβράδυνση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cap, and never slowed down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite y sin reducción de velocidad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون سقف مصرف، بدون کاهش سرعت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei rajoja eikä hidastuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune limite, aucun ralentissement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי מגבלת נפח ובלי האטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सीमा नहीं, और स्पीड कभी कम नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ograničenja i bez usporavanja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa batas kuota, dan tidak pernah diperlambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun limite e nessun rallentamento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шектеу жоқ, жылдамдық та бәсеңдетілмейді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានកំណត់ និងមិនបន្ថយល្បឿនឡើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 제한 없이, 속도 제한도 없이."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чектөө жок, ылдамдык да басаңдатылбайт."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကန့်သတ်ချက်မရှိ၊ မြန်နှုန်းလည်း ဘယ်တော့မှ မလျှော့ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen grense, og aldri strupet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen limiet en nooit afgeknepen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem limite e sem abrandamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без лимита и без замедления."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kikomo, na kasi haipunguzwi kamwe."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бе маҳдудият ва бе сустшавии суръат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่จำกัดปริมาณ และไม่ลดความเร็ว"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ደረት የብሉን፣ ፍጥነት እውን ኣይንኪን።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çäk ýok, tizlik hem hiç haçan peseldilmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kota yok, hız da hiç düşürülmüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ліміту й без уповільнення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheklov yoʻq, tezlik ham hech qachon pasaytirilmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không giới hạn dung lượng và không bao giờ bị bóp băng thông."
