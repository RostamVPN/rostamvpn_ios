            "state": "translated",
            "value": "Не удалось подключиться. Нажмите, чтобы повторить."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kuunganisha. Gusa ili ujaribu tena."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайваст нашуд. Барои кӯшиши дубора зер кунед."
