    "There is nothing to buy. Full speed, every region, no limits.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የሚገዛ ነገር የለም። ሙሉ ፍጥነት፣ በሁሉም አካባቢ፣ ያለ ገደብ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء للشراء. سرعة كاملة، كل المناطق، بلا حدود."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alınacaq bir şey yoxdur. Tam sürət, bütün bölgələr, limitsiz."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "آلیناجاق بیر شئی یوخدور. تام سورعت، بوتون بؤلگه‌لر، لیمیتسیز."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Купляць нічога не трэба. Поўная хуткасць, усе рэгіёны, без абмежаванняў."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཉོ་དགོས་པ་གང་ཡང་མེད། མྱུར་ཚད་ཡོངས་རྫོགས། ས་ཁུལ་ཡོངས། ཚད་བཀག་མེད།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ شتێک بۆ کڕین نییە. خێرایی تەواو، هەموو ناوچەکان، بێ سنوور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts zu kaufen. Volle Geschwindigkeit, alle Regionen, keine Limits."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει τίποτα προς αγορά. Πλήρης ταχύτητα, όλες οι περιοχές, χωρίς όρια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to buy. Full speed, every region, no limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que comprar. Velocidad completa, todas las regiones, sin límites."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی برای خرید نیست. سرعت کامل، همه مناطق، بدون محدودیت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei tarvitse ostaa. Täysi nopeus, kaikki alueet, ei rajoituksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a rien à acheter. Pleine vitesse, toutes les régions, sans limites."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מה לקנות. מהירות מלאה, בכל האזורים, ללא הגבלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदने के लिए कुछ नहीं है। पूरी गति, हर क्षेत्र, कोई सीमा नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema se što kupiti. Puna brzina, sve regije, bez ograničenja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang perlu dibeli. Kecepatan penuh, semua wilayah, tanpa batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nulla da acquistare. Velocità piena, tutte le regioni, nessun limite."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алатын ешнәрсе жоқ. Толық жылдамдық, барлық аймақ, шектеусіз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីត្រូវទិញទេ។ ល្បឿនពេញ គ្រប់តំបន់ គ្មានដែនកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입할 것이 없습니다. 최고 속도, 모든 지역, 제한 없음."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып ала турган эч нерсе жок. Толук ылдамдык, бардык регион, чектөөсүз."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဝယ်ယူစရာ မရှိပါ။ အပြည့်အဝ အမြန်နှုန်း၊ ဒေသတိုင်း၊ ကန့်သတ်ချက်မရှိ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingenting å kjøpe. Full hastighet, alle regioner, ingen grenser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er valt niets te kopen. Volle snelheid, elke regio, geen limieten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada para comprar. Velocidade total, todas as regiões, sem limites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупать нечего. Полная скорость, все регионы, без ограничений."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna cha kununua. Kasi kamili, kila eneo, bila vikomo."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чизе барои харид нест. Суръати пурра, ҳамаи минтақаҳо, бе маҳдудият."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรต้องซื้อ ความเร็วเต็มที่ ทุกภูมิภาค ไม่มีขีดจำกัด"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ዝግዛእ ነገር የለን። ምሉእ ቅልጣፈ፣ ኣብ ኩሉ ከባቢ፣ ብዘይ ደረት።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Satyn alara zat ýok. Doly tizlik, ähli sebitler, çäklendirmesiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
