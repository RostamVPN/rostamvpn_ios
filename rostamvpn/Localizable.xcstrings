    "Every region, switch anytime": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁሉም ክልሎች፣ በማንኛውም ጊዜ ይቀይሩ"
          }
        },
