    "The free allowance renews every month. Premium has no cap.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ነጻ ድርሻው በየወሩ ይታደሳል። ፕሪሚየም ገደብ የለውም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدد الحصة المجانية كل شهر. الاشتراك المميز بلا حد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz limit hər ay yenilənir. Premium-da limit yoxdur."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "پولسوز سهمیه هر آی یئنیله‌نیر. اؤزل نۆسخه‌ده حدّ یوخدور."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Бясплатны ліміт абнаўляецца штомесяц. У Premium няма ліміту."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "རིན་མེད་ཚད་གཞི་ཟླ་རེར་གསར་སྒྱུར་བྱེད། Premium ལ་ཚད་མེད།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بەشە بەخۆڕاییەکە هەموو مانگێک نوێ دەبێتەوە. پرێمیۆم سنووری نییە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gratis-Kontingent erneuert sich jeden Monat. Premium hat kein Limit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
