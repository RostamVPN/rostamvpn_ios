    "Protection is off. Turn it on in Rules.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ጥበቃ ጠፍቷል። በደንቦች ውስጥ ያብሩት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحماية متوقفة. شغّلها من القواعد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoruma söndürülüb. Onu Qaydalar bölməsində yandırın."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "قوروما سؤنوکدور. اونو قایدالاردا یاندیرین."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абарона выключана. Уключыце яе ў раздзеле «Правілы»."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྲུང་སྐྱོབ་བཀག་ཡོད། སྒྲིག་སྲོལ་ནང་དུ་ཁ་ཕྱེ་རོགས།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پاراستن کوژاوەتەوە. لە یاساکان هەڵیبکە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schutz ist aus. Aktivieren Sie ihn unter Regeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προστασία είναι ανενεργή. Ενεργοποιήστε την στους Κανόνες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección está desactivada. Actívala en Reglas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محافظت خاموش است. آن را در قوانین روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojaus on pois päältä. Ota se käyttöön kohdassa Säännöt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection est désactivée. Activez-la dans Règles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגנה כבויה. אפשר להפעיל אותה בכללים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा बंद है। इसे नियम में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaštita je isključena. Uključite je u Pravilima."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlindungan nonaktif. Aktifkan di Aturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La protezione è disattivata. Attivala in Regole."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорғаныс өшірулі. Оны «Ережелер» бөлімінде қосыңыз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការការពារត្រូវបានបិទ។ បើកវានៅក្នុងច្បាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호가 꺼져 있어요. 규칙에서 켜세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Коргоо өчүк. Аны «Эрежелер» бөлүмүнөн күйгүзүңүз."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကာကွယ်မှု ပိတ်ထားသည်။ စည်းမျဉ်းများတွင် ဖွင့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskyttelse er av. Slå den på i Regler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherming staat uit. Zet hem aan bij Regels."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção está desativada. Ative em Regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защита выключена. Включите её в разделе «Правила»."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulinzi umezimwa. Uwashe katika Sheria."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳимоя хомӯш аст. Онро дар «Қоидаҳо» фаъол кунед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้องกันปิดอยู่ เปิดได้ในกฎ"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ሓለዋ ጠፊኡ ኣሎ። ኣብ ሕግታት ወልዕዎ።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gorag öçük. Ony Düzgünler bölüminde açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koruma kapalı. Kurallar bölümünden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захист вимкнено. Увімкніть його в розділі «Правила»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Himoya o‘chiq. Uni “Qoidalar” bo‘limida yoqing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo vệ đang tắt. Hãy bật trong Quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护已关闭。请在“规则”中开启。"
          }
        }
      }
    },
    "Refuse known malware, phishing and hijacked hosts.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የታወቁ ተንኮል-አዘል፣ የማስገር እና የተጠለፉ አገልጋዮችን ውድቅ ያድርጉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المواقع المعروفة بالبرامج الضارة والتصيّد والاختراق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlum zərərli proqram, fişinq və ələ keçirilmiş serverləri rədd et."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "تانینمیش زیانلی پروقراملاری، فیشینقی و اله کئچیریلمیش هاستلاری رد ائت."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Блакіраваць вядомыя шкоднасныя, фішынгавыя і захопленыя вузлы."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཤེས་ཟིན་པའི་ཉེས་ཅན་མཉེན་ཆས་དང་། མགོ་སྐོར་དྲ་ཚིགས། བཙན་འཕྲོག་བྱས་པའི་ཞབས་ཞུ་ཆས་རྣམས་ཁས་མི་ལེན།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕەتکردنەوەی نەرمەواڵەی زیانبەخش، فیشینگ و هۆستە دەستبەسەرداگیراوە ناسراوەکان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekannte Malware-, Phishing- und gekaperte Hosts abweisen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόρριψη γνωστών κακόβουλων, παραπλανητικών και παραβιασμένων διακομιστών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechaza hosts conocidos de malware, phishing o secuestrados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کردن بدافزارها، فیشینگ و میزبان‌های ربوده‌شده شناخته‌شده."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Torju tunnetut haittaohjelma-, tietojenkalastelu- ja kaapatut palvelimet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuser les hôtes connus de malware, d'hameçonnage ou détournés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת שרתים ידועים של תוכנות זדוניות, פישינג ושרתים חטופים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाने-पहचाने मैलवेयर, फ़िशिंग और हाइजैक किए गए होस्ट रोकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbij poznati zlonamjerni softver, phishing i otete poslužitelje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolak host malware, phishing, dan host dibajak yang sudah dikenal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiuta host noti di malware, phishing e compromessi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгілі зиянды, фишингтік және басып алынған хосттарды бұғаттау."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បដិសេធម៉ាស៊ីនមេរោគ បោកបញ្ឆោត និងម៉ាស៊ីនដែលត្រូវបានលួចគ្រប់គ្រងដែលគេស្គាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려진 악성코드, 피싱, 탈취된 호스트를 거부해요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгилүү зыяндуу, фишинг жана басып алынган хостторду бөгөттөө."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သိရှိပြီးသော မဲလ်ဝဲ၊ ဖစ်ရှင်းနှင့် အသိမ်းခံထားရသော ဟို့စ်များကို ငြင်းပယ်ရန်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvis kjent skadevare, nettfiske og kaprede verter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiger bekende malware-, phishing- en gekaapte hosts."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusar hosts conhecidos de malware, phishing e sequestrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать известные вредоносные, фишинговые и захваченные узлы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataa programu hasidi, hadaa na seva zilizotekwa zinazojulikana."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рад кардани хостҳои маълуми зараровар, фишингӣ ва ғасбшуда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิเสธโฮสต์มัลแวร์ ฟิชชิง และโฮสต์ที่ถูกยึดที่รู้จัก"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ፍሉጣት ተንኮላዊ፣ ናይ ምትላልን ዝተጨውዩን ኣገልገልቲ ንጸጉ።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Belli zyýanly programmalary, fişingi we eýelenen serwerleri ret et."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinen kötü amaçlı yazılım, kimlik avı ve ele geçirilmiş sunucuları reddet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокувати відомі шкідливі, фішингові та захоплені вузли."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lum zararli, fishing va egallab olingan hostlarni rad etish."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ chối các máy chủ phần mềm độc hại, lừa đảo và bị chiếm quyền đã biết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝已知的恶意软件、钓鱼和被劫持主机。"
          }
        }
      }
    },
