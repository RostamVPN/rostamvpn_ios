    "Sites you allow from the timeline appear here.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከጊዜ መስመሩ የሚፈቅዷቸው ጣቢያዎች እዚህ ይታያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المواقع التي تسمح بها من السجل الزمني."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xronologiyadan icazə verdiyiniz saytlar burada görünür."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "زامان خطیندن ایجازه وئردیگینیز سایتلار بوردا گؤرونور."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явяцца сайты, якія вы дазволіце са стужкі."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "དུས་རིམ་ནས་ཁྱེད་ཀྱིས་ཆོག་མཆན་སྤྲད་པའི་དྲ་ཚིགས་རྣམས་འདིར་མངོན།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو ماڵپەڕانەی لە هێڵی کاتەوە ڕێگەیان پێدەدەیت لێرە دەردەکەون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites, die Sie in der Zeitleiste erlauben, erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ιστότοποι που επιτρέπετε από το χρονολόγιο εμφανίζονται εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sitios que permitas desde el historial aparecen aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سایت‌هایی که از خط زمانی اجازه می‌دهید اینجا نمایش داده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikajanalta sallimasi sivustot näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sites que vous autorisez depuis l'historique s'affichent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתרים שתאפשרו מציר הזמן יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमलाइन से जिन साइटों को आप अनुमति देते हैं, वे यहाँ दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranice koje dopustite s vremenske crte prikazuju se ovdje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Situs yang Anda izinkan dari linimasa muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I siti che consenti dalla cronologia appaiono qui."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронологиядан рұқсат еткен сайттарыңыз осында көрсетіледі."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គេហទំព័រដែលអ្នកអនុញ្ញាតពីបន្ទាត់ពេលវេលា បង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인에서 허용한 사이트가 여기에 표시돼요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тасмадан уруксат берген сайттарыңыз бул жерде көрүнөт."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အချိန်ဇယားမှ သင်ခွင့်ပြုသော ဆိုက်များကို ဤနေရာတွင် ပြသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettsteder du tillater fra tidslinjen, vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites die je vanuit de tijdlijn toestaat, verschijnen hier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sites que você permitir na linha do tempo aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся сайты, которые вы разрешите из ленты."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tovuti unazoruhusu kutoka kwenye rekodi ya matukio huonekana hapa."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайтҳое, ки аз хронология иҷозат медиҳед, дар ин ҷо пайдо мешаванд."
