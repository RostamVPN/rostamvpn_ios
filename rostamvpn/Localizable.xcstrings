    "Connect anywhere, switch anytime.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከየትም ይገናኙ፣ በፈለጉት ጊዜ ይቀይሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل من أي مكان، وبدّل وقتما تشاء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstənilən yerə qoşulun, istənilən vaxt dəyişin."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "هر یئره باغلانین، هر واخت ده‌ییشین."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падключайцеся адкуль заўгодна, пераключайцеся калі заўгодна."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ས་གནས་གང་ནས་ཀྱང་སྦྲེལ་མཐུད་བྱེད་ཐུབ། ནམ་ཡང་བརྗེ་ཐུབ།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لە هەر شوێنێکەوە پەیوەندی بکە، هەر کاتێک بتەوێت بگۆڕە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von überall verbinden, jederzeit wechseln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε από παντού, αλλάξτε όποτε θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect anywhere, switch anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate desde cualquier lugar y cambia cuando quieras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به هر منطقه وصل شوید و هر وقت خواستید عوض کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä mistä tahansa, vaihda milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous de partout, changez quand vous voulez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו מכל מקום, החליפו בכל רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहीं से भी कनेक्ट करें, कभी भी बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojite se odakle god želite i mijenjajte kad god želite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung dari mana saja, ganti kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti da ovunque, cambia quando vuoi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалаған жерден қосылыңыз, қалаған кезде ауыстырыңыз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តភ្ជាប់ពីគ្រប់ទីកន្លែង ប្ដូរបានគ្រប់ពេល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 연결하고 언제든 바꾸세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Каалаган жерден туташыңыз, каалаган убакта алмаштырыңыз."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဘယ်နေရာကမဆို ချိတ်ဆက်ပြီး အချိန်မရွေး ပြောင်းနိုင်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til hvor som helst, bytt når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind vanaf elke plek, wissel wanneer je wilt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue-se de qualquer lugar e mude quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключайтесь откуда угодно, переключайтесь когда угодно."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unganisha kutoka popote, badilisha wakati wowote."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз ҳар ҷо пайваст шавед, ҳар вақт иваз кунед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อจากที่ไหนก็ได้ สลับเมื่อไรก็ได้"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ካብ ዝኾነ ቦታ ተራኸቡ፣ ኣብ ዝደለኹምዎ ግዜ ቀይሩ።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Islendik ýerden birikdiriň, islendik wagt çalşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerden bağlanın, istediğiniz zaman değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключайтеся звідусіль, перемикайтеся будь-коли."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Istalgan joydan ulaning, istalgan vaqtda almashtiring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối từ bất cứ đâu, đổi bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时切换全球任意线路。"
          }
        }
      }
    },
