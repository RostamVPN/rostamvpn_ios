    "No cap and no allowance to count down.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ገደብ የለም፣ የሚቆጠር ኮታም የለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حد أقصى ولا رصيد يتناقص."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit yoxdur, azalan kvota yoxdur."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "سقف یوخ، آزالان سهمیه ده یوخ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніякіх лімітаў і лічыльнікаў трафіку."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཚད་བཀག་མེད་ལ་བགྲང་དགོས་པའི་ཚད་གཞི་ཡང་མེད།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بێ سنوور و بێ بڕێک کە کەم ببێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Limit und kein Kontingent, das abläuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς όριο και χωρίς ποσόστωση που μετράει αντίστροφα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tope ni cupo que se agote."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون سقف و بدون سهمیه‌ای که کم شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ylärajaa eikä kiintiötä, jota laskea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun plafond, aucun quota à surveiller."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי תקרה ובלי מכסה שנגמרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न कोई सीमा, न घटता हुआ कोटा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ograničenja i bez kvote koja se troši."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa batas dan tanpa kuota yang terus berkurang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun limite e nessuna soglia da scalare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шектеу жоқ, кері санайтын лимит те жоқ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានកម្រិតកំណត់ និងគ្មានកូតាត្រូវរាប់ថយក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도도 없고, 남은 용량을 셀 필요도 없어요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чектөө жок, азайып бара турган лимит да жок."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကန့်သတ်ချက် မရှိ၊ လျော့ရေတွက်ရမည့် ခွဲတမ်းလည်း မရှိ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tak og ingen kvote å telle ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen limiet en geen tegoed dat afloopt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem limite e sem franquia para ir acabando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никаких лимитов и счётчиков трафика."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kikomo wala kiwango cha kuhesabu."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҳдудият нест ва ҳаҷме ҳам нест, ки кам шавад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเพดาน ไม่มีโควตาให้นับถอยหลัง"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ደረት የለን፣ ዝቑጸር ኮታ ድማ የለን።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çäk ýok, azalýan limit ýok."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kota yok, azalan bir limit yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодних лімітів і лічильників трафіку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheklov yo‘q, kamayib boradigan limit ham yo‘q."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không giới hạn dung lượng, không phải đếm lùi hạn mức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有上限，也无需盯着剩余额度。"
          }
        }
      }
    },
