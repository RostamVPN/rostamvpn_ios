          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Купувати нічого не потрібно. Повна швидкість, усі регіони, без обмежень."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotib olinadigan narsa yoʻq. Toʻliq tezlik, barcha hududlar, cheklovsiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì để mua. Tốc độ tối đa, mọi khu vực, không giới hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
