        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ས་ཁུལ་ཚང་མ། དུས་ནམ་ཡིན་རུང་བརྗེ་ཆོག"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەموو ناوچەکان، هەر کاتێک بیگۆڕە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Region, jederzeit wechseln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε περιοχή, αλλαγή οποτεδήποτε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las regiones, cambia cuando quieras"
