    "Your free data is a one-time allowance. Premium never runs out.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ነጻ ድርሻው አንድ ጊዜ ብቻ ነው የሚሰጠው። በፕሪሚየም ዳታ ፈጽሞ አያልቅም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحصة المجانية تُمنح مرة واحدة فقط. مع الاشتراك المميز لا تنفد البيانات أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz limit yalnız bir dəfə verilir. Premium-da trafik heç vaxt bitmir."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "پولسوز سهمیه یالنیز بیر دفعه وئریلیر. اؤزل نۆسخه‌ده داده هئچ واخت قورتارمیر."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Бясплатны ліміт даецца толькі адзін раз. З Premium даныя ніколі не заканчваюцца."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "རིན་མེད་ཚད་གཞི་ནི་ཐེངས་གཅིག་ཁོ་ན་ཡིན། Premium ལ་གྲངས་གཞི་ནམ་ཡང་རྫོགས་མི་སྲིད།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بەشە بەخۆڕاییەکە تەنها جارێک دەدرێت. لەگەڵ پرێمیۆم داتا هەرگیز تەواو نابێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gratis-Kontingent gibt es nur einmal. Mit Premium gehen die Daten nie aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δωρεάν όριο δίνεται μόνο μία φορά. Με το Premium τα δεδομένα δεν τελειώνουν ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free data is a one-time allowance. Premium never runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuota gratuita se da una sola vez. Con Premium los datos nunca se acaban."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سهمیهٔ رایگان فقط یک‌بار داده می‌شود. با پرمیوم داده هیچ‌وقت تمام نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kiintiö annetaan vain kerran. Premiumissa data ei lopu koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota gratuit n'est accordé qu'une seule fois. Avec Premium, les données ne s'épuisent jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכסה החינמית ניתנת פעם אחת בלבד. עם פרימיום הנתונים לא נגמרים אף פעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त कोटा सिर्फ़ एक बार मिलता है। Premium के साथ डेटा कभी ख़त्म नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatna kvota dobiva se samo jednom. Uz Premium podaci se nikada ne potroše."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuota gratis diberikan satu kali saja. Dengan Premium, data tidak pernah habis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota gratuita viene concessa una sola volta. Con Premium i dati non si esauriscono mai."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегін көлем бір рет қана беріледі. Premium-да трафик ешқашан таусылмайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កូតាឥតគិតថ្លៃត្រូវបានផ្តល់ជូនតែម្តងប៉ុណ្ណោះ។ ជាមួយ Premium ទិន្នន័យមិនដែលអស់ឡើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 제공량은 한 번만 제공됩니다. Premium은 데이터가 절대 소진되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акысыз көлөм бир гана жолу берилет. Premium менен трафик эч качан түгөнбөйт."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခမဲ့ကုတာကို တစ်ကြိမ်သာ ပေးပါသည်။ Premium ဖြင့် ဒေတာ ဘယ်တော့မှ မကုန်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratiskvoten gis bare én gang. Med Premium går du aldri tom for data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gratis tegoed krijg je maar één keer. Met Premium raakt je data nooit op."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota gratuita é concedida uma única vez. Com o Premium, os dados nunca acabam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный объём даётся один раз. С Premium трафик никогда не заканчивается."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiasi cha bure hutolewa mara moja tu. Kwa Premium, data haiishi kamwe."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳаҷми ройгон танҳо як бор дода мешавад. Бо Premium ҳаҷм ҳеҷ гоҳ тамом намешавад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โควตาฟรีให้เพียงครั้งเดียว เมื่อใช้ Premium ข้อมูลไม่มีวันหมด"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ናጻ ኮታ ሓንሳብ ጥራይ እዩ ዝወሃብ። ምስ Premium ዳታ ፈጺሙ ኣይውዳእን።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mugt kwota diňe bir gezek berilýär. Premium bilen trafik hiç haçan gutarmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz kota yalnızca bir kez verilir. Premium'da veri hiç bitmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовний обсяг надається лише один раз. З Premium дані ніколи не закінчуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
