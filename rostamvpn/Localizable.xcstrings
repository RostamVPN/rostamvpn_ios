    "Changes apply the next time you connect.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለውጦቹ በሚቀጥለው ጊዜ ሲገናኙ ተግባራዊ ይሆናሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق التغييرات عند الاتصال في المرة القادمة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişikliklər növbəti qoşulmada tətbiq olunacaq."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "دَییشیکلیکلر سونراکی باغلانتیدا اعمال اولوناجاق."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены ўступяць у сілу пры наступным падключэнні."
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཐེངས་རྗེས་མར་སྦྲེལ་མཐུད་བྱེད་སྐབས་བཟོ་བཅོས་ནུས་པ་ལྡན་ངེས།"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "گۆڕانکارییەکان لە پەیوەندیکردنی داهاتوودا جێبەجێ دەبن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten ab der nächsten Verbindung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές θα ισχύσουν στην επόμενη σύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplicarán la próxima vez que te conectes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات دفعهٔ بعد که وصل شوید اعمال می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset tulevat voimaan, kun yhdistät seuraavan kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s’appliqueront à votre prochaine connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינויים ייכנסו לתוקף בפעם הבאה שתתחברו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव अगली बार कनेक्ट करने पर लागू होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene će se primijeniti pri sljedećem povezivanju."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan berlaku saat Anda terhubung berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche verranno applicate alla prossima connessione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерістер келесі қосылғанда күшіне енеді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ប្ដូរនឹងមានប្រសិទ្ធភាពនៅពេលអ្នកភ្ជាប់លើកក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 다음 연결 시 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөрүүлөр кийинки туташууда күчүнө кирет."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နောက်တစ်ကြိမ် ချိတ်ဆက်သည့်အခါ ပြောင်းလဲမှုများ အသက်ဝင်ပါမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringene gjelder neste gang du kobler til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden toegepast bij je volgende verbinding."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações serão aplicadas na próxima vez que você se conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения вступят в силу при следующем подключении."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabadiliko yatatumika utakapounganisha tena."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйирот ҳангоми пайвастшавии навбатӣ амал мекунад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงจะมีผลเมื่อคุณเชื่อมต่อครั้งถัดไป"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ለውጥታት ኣብ ዝቕጽል ምርኻብ ተግባራዊ ኪኾኑ እዮም።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Üýtgeşmeler indiki birikmede güýje girer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler bir sonraki bağlantıda uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни набудуть чинності під час наступного підключення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlar keyingi ulanishda kuchga kiradi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi sẽ áp dụng vào lần kết nối tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改将在下次连接时生效。"
          }
        }
      }
    },
