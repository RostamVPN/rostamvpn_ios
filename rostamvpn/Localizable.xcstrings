        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว็บไซต์ที่คุณอนุญาตจากไทม์ไลน์จะแสดงที่นี่"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ካብ መስመር ግዜ እተፍቅድዎም መርበባት ኣብዚ ይርኣዩ።"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
